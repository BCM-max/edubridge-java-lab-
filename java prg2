class Student {
    int id;
    String name;
    int age;

    void display() {
        System.out.println(id + " " + name + " " + age);
    }
}

public class Main {
    public static void main(String[] args) {
        // Creating first object of Student class
        Student s1 = new Student();
        s1.id =101;
        s1.name = "ram";
        s1.age = 20;

        // Creating second object of same Student class
        Student s2 = new Student();
        s2.id = 102;
        s2.name = "krish";
        s2.age = 21;

        // Creating third object of same Student class
        Student s3 = new Student();
        s3.id = 103;
        s3.name = "shiv";
        s3.age = 19;

        System.out.println("Student Details:");
        s1.display();
        s2.display();
        s3.display();
    }
}
